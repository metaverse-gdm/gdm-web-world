# Comma-separated Ed25519 did:key values. Root DIDs are public.
VITE_ROOT_ADMIN_DIDS=
VITE_BASE_PATH=/worlds/

# FTPS target for scripts/ftps-upload.mjs (`just deploy`) — public URL https://gdm.tik-choco.com/worlds/.
# Only files whose content changed since the last upload are sent (state in .deploy-manifest.json on the server).
# FTPS_HOST=ftp.example.com
# FTPS_USER=
# The password does not go here: `just ftps-login` stores it DPAPI-encrypted in
# %APPDATA%\tc-linkai\ftps.cred (shared with tc-game / tc-linkai), readable only by your Windows user.
# Directory on the server that is served as gdm.tik-choco.com/worlds (adjust to the subdomain's document root).
FTPS_REMOTE_DIR=/gdm/worlds
# FTPS_SECURE=true            # true = explicit TLS (port 21), implicit = port 990, false = plain FTP
# FTPS_PORT=21
# FTPS_CONCURRENCY=1          # parallel connections; some shared hosts reset data sockets above 1
# FTPS_ALLOW_SELF_SIGNED=false
