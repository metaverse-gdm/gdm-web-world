# Serve the mistlib engine with the MIME type WebAssembly.instantiateStreaming requires.
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # Keep the CDN/browser from serving a stale page after re-uploading.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never serve dotfiles (e.g. the deploy manifest).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
